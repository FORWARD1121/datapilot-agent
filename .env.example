# Keep local mode bound to 127.0.0.1. Public deployment requires a long API_TOKEN.
APP_ENV=local
DATA_DIR=.datapilot
# DATABASE_URL=sqlite:///.datapilot/datapilot.db
API_TOKEN=
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=50000
MAX_COLUMNS=100
MAX_CELLS=1000000
# RULES_PATH=/absolute/path/to/your/rules.json
